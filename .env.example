# Copy to .env and fill in values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required on Vercel (Project → Settings → Environment Variables).
# Without SUPABASE_URL + SUPABASE_ANON_KEY (or the NEXT_PUBLIC_* pair),
# /admin shows "In-memory" with all zeros.
#
# After deploy, run supabase/migrations/*.sql in the Supabase SQL editor
# (especially 20260914150000_adeola_style_baselines.sql) so visits start
# from the seeded baseline (~1462) and keep incrementing Adeola-style.

# GitHub Actions secrets for hourly download drip (Settings → Secrets → Actions):
# SUPABASE_URL, SUPABASE_ANON_KEY
# Local drip: npm run increment-downloads
# After clone, run supabase/migrations/*.sql in the Supabase SQL editor (in order).
